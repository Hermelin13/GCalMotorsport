# Google Calendar ID, e.g. abc123@group.calendar.google.com
GOOGLE_CALENDAR_ID=
# Google service account JSON content, base64-encoded (recommended in GitHub Actions)
GOOGLE_CREDENTIALS_B64=
# Alternatively local path to a service account JSON
GOOGLE_CREDENTIALS_FILE=
DISCORD_WEBHOOK_URL=
# Separate optional ICS subscriptions, one per series (public HTTPS URL)
F1_ICS_URL=
FORMULA_E_ICS_URL=
WEC_ICS_URL=
NURBURGRING_ICS_URL=
DAYTONA_ICS_URL=
# Optional manually curated exact starts, JSON file in config/ (see example)
OVERRIDES_FILE=config/starts.json
TIMEZONE=Europe/Prague
DRY_RUN=true
# Do not automatically delete events without confirmed official cancellation
